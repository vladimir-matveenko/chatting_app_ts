{
  "compilerOptions": {
    // Project sturcture
    "rootDir": "./src",
    "outDir": "./dist",
    // Node.js
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    // Compilation
    "sourceMap": true,
    // Tests
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    // Compatibility
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "include": ["src/**/*", "scripts"],
  "exclude": ["node_modules", "dist"]
}
